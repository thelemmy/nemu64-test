{
  "arch": "mips64",
  "cpu": "mips3",
  "data-layout": "E-m:e-i8:8:32-i16:16:32-i64:64-n32:64-S64",
  "disable-redzone": true,
  "env": "unknown",
  "features": "",
  "linker": "rust-lld",
  "linker-flavor": "ld.lld",
  "llvm-target": "mips64-unknown-unknown",
  "os": "none",
  "panic-strategy": "abort",
  "pre-link-args": {
    "ld.lld": [
      "--script=linker.ld"
    ]
  },
  "relocation-model": "static",
  "target-endian": "big",
  "target-pointer-width": "64",
  "vendor": "nintendo64"
}